# GOOGLE DRIVE / CLOUDINARY: SERVER ONLY. Never prefix these credentials with VITE_.
# Do not commit environment files containing credentials.
# OAuth refresh token with the drive.readonly scope; no Drive write scope needed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# BROWSER PUBLIC CONFIGURATION ONLY. EmailJS IDs and public key are safe for the client.
# Never put a Gmail password, OAuth token, or EmailJS private key in VITE_ variables.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
